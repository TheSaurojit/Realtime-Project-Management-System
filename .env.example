# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/project_management?schema=public"

# Session JWT Secret (minimum 32 characters required)
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Pusher credentials (built-in SSE real-time runs automatically when blank)
PUSHER_APP_ID=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# Resend API Key for Email Sending (Sign up at https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="SyncBoard <onboarding@resend.dev>"

# Supabase Storage (for task attachments, images only up to 10MB)
# Sign up at https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SECRET_KEY="your-secret-key"
SUPABASE_STORAGE_BUCKET="attachments"